<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ site.domain }}{{ page.url }}">
<link rel="alternate" hreflang="ko" href="{{ site.domain }}{{ altKo }}">
<link rel="alternate" hreflang="en" href="{{ site.domain }}{{ altEn }}">
<link rel="alternate" hreflang="x-default" href="{{ site.domain }}{{ altKo }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.domain }}{{ page.url }}">
<meta property="og:site_name" content="청담채 CheongDamChae">
<meta property="og:locale" content="{{ 'ko_KR' if lang == 'ko' else 'en_SG' }}">
<meta property="og:image" content="{{ site.domain }}{{ ogImage or site.ogFallback }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.domain }}{{ ogImage or site.ogFallback }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
{% if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
</head>
<body>

<section class="news-top">
  <div class="news-wrap">
    <div style="display:flex; justify-content:space-between; align-items:center; gap:18px; flex-wrap:wrap; margin-bottom:26px;">
      <a class="back" href="{{ '/' if lang == 'ko' else '/en/' }}">← {{ '청담채 홈' if lang == 'ko' else 'CheongDamChae Home' }}</a>
      <span class="lang-switch">
        <a href="{{ altKo }}" class="{{ 'on' if lang == 'ko' }}">한국어</a>
        <a href="{{ altEn }}" class="{{ 'on' if lang == 'en' }}">EN</a>
      </span>
    </div>
    <h1>{{ heading }}</h1>
    {% if subheading %}<p class="sub">{{ subheading }}</p>{% endif %}
  </div>
</section>

{{ content | safe }}

<footer>
  <div class="wrap">
    <div style="display:flex; align-items:center; gap:14px; margin-bottom:24px;">
      <img src="/images/logo.png" width="381" height="191" loading="lazy" decoding="async" alt="청담채 CheongDamChae 로고" style="height:32px; width:auto; opacity:0.9;">
    </div>
    <div class="foot-row">
      <div style="display:flex; flex-direction:column; gap:8px;">
        <div>123 Telok Ayer Street, Singapore 068592</div>
        <div>{{ site.phone }} · {{ '매일 11:00–23:30' if lang == 'ko' else 'Daily 11:00–23:30' }}</div>
      </div>
      <div style="display:flex; gap:20px; align-items:center;">
        <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
        <a href="{{ site.booking }}" target="_blank" rel="noopener">{{ '예약' if lang == 'ko' else 'Reserve' }}</a>
      </div>
    </div>
  </div>
</footer>

</body>
</html>
