---
permalink: "/en/news/"
layout: news-base.njk
lang: en
heading: "News"
subheading: "New dishes, ingredient stories and what's happening at the restaurant."
pageTitle: "News | CheongDamChae Korean BBQ, Telok Ayer Singapore"
pageDesc: "New dishes, ingredient stories and updates from CheongDamChae, a Korean BBQ restaurant on Telok Ayer Street, Singapore."
altKo: "/news/"
altEn: "/en/news/"
---
<div class="news-wrap news-list">
  {% if news.length == 0 %}
    <p style="color:var(--ink-700);">No posts yet.</p>
  {% endif %}
  {% for post in news %}
  <article class="news-card">
    <div class="thumb">
      {% if post.cover %}
        <a href="/en/news/{{ post.slug }}/"><img src="{{ post.cover }}" alt="{{ post.coverAlt or post.en.title }}" loading="lazy" decoding="async"></a>
      {% endif %}
    </div>
    <div>
      <time datetime="{{ post.date | dateIso }}">{{ post.date | dateEn }}</time>
      <h2><a href="/en/news/{{ post.slug }}/">{{ post.en.title }}</a>{% if not post.en.translated %}<span class="badge">KO</span>{% endif %}</h2>
      <p>{{ post.en.summary }}</p>
    </div>
  </article>
  {% endfor %}
</div>
