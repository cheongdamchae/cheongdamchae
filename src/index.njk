{% if news.length %}
<section class="section dark" id="news">
  <div class="wrap">
    <div class="section-head">
      <div class="label" style="color:var(--brass-400);">소식</div>
      <h2>What's New</h2>
      <p>새 메뉴, 재료 이야기, 매장 소식을 전해드립니다.</p>
    </div>
    <div class="home-news-grid">
      {% for post in news | limit(3) %}
      <a class="home-news-item" href="/news/{{ post.slug }}/">
        <div class="thumb">
          {% if post.cover %}<img src="{{ post.cover }}" alt="{{ post.coverAlt or post.ko.title }}" loading="lazy" decoding="async">{% endif %}
        </div>
        <time datetime="{{ post.date | dateIso }}">{{ post.date | dateKo }}</time>
        <h3>{{ post.ko.title }}</h3>
        <p>{{ post.ko.summary }}</p>
      </a>
      {% endfor %}
    </div>
    <a class="news-more" href="/news/">소식 전체 보기 →</a>
  </div>
</section>
{% endif %}

