---
pagination:
  data: copy.langs
  size: 1
  alias: lang
permalink: "{{ copy.home[lang] }}"
eleventyExcludeFromCollections: true
---
{% set other = "ko" if lang == "en" else "en" %}
{% set S = copy.sections %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ copy.meta.title[lang] }}</title>
<meta name="description" content="{{ copy.meta.description[lang] }}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{{ site.domain }}{{ copy.home[lang] }}">
<link rel="alternate" hreflang="en" href="{{ site.domain }}/">
<link rel="alternate" hreflang="ko" href="{{ site.domain }}/ko/">
<link rel="alternate" hreflang="x-default" href="{{ site.domain }}/">
<meta property="og:type" content="restaurant.restaurant">
<meta property="og:title" content="{{ copy.meta.ogTitle[lang] }}">
<meta property="og:description" content="{{ copy.meta.ogDescription[lang] }}">
<meta property="og:locale" content="{{ copy.meta.locale[lang] }}">
<meta property="og:site_name" content="CheongDamChae 청담채">
<meta property="og:url" content="{{ site.domain }}{{ copy.home[lang] }}">
<meta property="og:image" content="{{ site.domain }}/images/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ copy.meta.ogImageAlt[lang] }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.domain }}/images/og-cover.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
{% if lang == "en" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "@id": "{{ site.domain }}/#restaurant",
  "name": "CheongDamChae 청담채",
  "url": "{{ site.domain }}/",
  "image": [
    "{{ site.domain }}/images/space-storefront.webp",
    "{{ site.domain }}/images/pasam.webp",
    "{{ site.domain }}/images/naengsam.webp"
  ],
  "logo": "{{ site.domain }}/images/logo.png",
  "description": {{ copy.meta.ldDescription.en | dump | safe }},
  "servesCuisine": ["Korean", "Korean BBQ"],
  "priceRange": "$$",
  "currenciesAccepted": "SGD",
  "telephone": "+65-8080-5181",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "123 Telok Ayer Street",
    "addressLocality": "Singapore",
    "postalCode": "068592",
    "addressCountry": "SG"
  },
  "geo": {"@type": "GeoCoordinates", "latitude": 1.2811983, "longitude": 103.84802},
  "hasMap": "https://www.google.com/maps/search/?api=1&query=CheongDamChae&query_place_id=ChIJoZsYEQAZ2jERGCh9m8C_Rvc",
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "11:00",
    "closes": "23:30"
  },
  "sameAs": ["{{ site.instagram }}"],
  "acceptsReservations": "True",
  "potentialAction": {
    "@type": "ReserveAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ site.booking }}",
      "actionPlatform": ["http://schema.org/DesktopWebPlatform", "http://schema.org/MobileWebPlatform"]
    }
  },
  "hasMenu": {
    "@type": "Menu",
    "name": "CheongDamChae Menu",
    "inLanguage": "en",
    "hasMenuSection": [
      {
        "@type": "MenuSection",
        "name": "Signature",
        "hasMenuItem": [
{% set first = true %}{% for d in copy.signature %}{% for p in d.prices %}{% if not first %},{% endif %}{% set first = false %}
          {"@type": "MenuItem", "name": {{ (d.name.en + " " + d.name.ko) | dump | safe }}, "offers": {"@type": "Offer", "price": "{{ p.amt | replace("SGD ", "") | replace("++", "") }}", "priceCurrency": "SGD", "description": {{ p.label.en | dump | safe }}}}
{%- endfor %}{% endfor %}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "From The Kitchen",
        "hasMenuItem": [
{% for d in copy.more %}{% if not loop.first %},{% endif %}
          {"@type": "MenuItem", "name": {{ (d.name.en + " " + d.name.ko) | dump | safe }}{% if d.price %}, "offers": {"@type": "Offer", "price": "{{ d.price | replace("SGD ", "") | replace("++", "") }}", "priceCurrency": "SGD"}{% endif %}}
{%- endfor %}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "Hot Pot Rice",
        "hasMenuItem": [
{% for d in copy.sotbap %}{% if not loop.first %},{% endif %}
          {"@type": "MenuItem", "name": {{ (d.name.en + " " + d.name.ko) | dump | safe }}}
{%- endfor %}
        ]
      }
    ]
  }
}
</script>
{% endif %}
</head>
<body>

<header class="site">
  <div class="nav">
    <div class="brand">
      <img class="brand-logo" src="/images/logo.png" width="381" height="191" fetchpriority="high" alt="CheongDamChae 청담채 logo">
    </div>
    <nav class="links">
      <a href="#signature">{{ copy.nav.signature[lang] }}</a>
      <a href="#more-menu">{{ copy.nav.menu[lang] }}</a>
      <a href="#sotbap">{{ copy.nav.sotbap[lang] }}</a>
      <a href="#space">{{ copy.nav.space[lang] }}</a>
      <a href="#why">{{ copy.nav.why[lang] }}</a>
      <a href="#news">{{ copy.nav.news[lang] }}</a>
      <a href="#visit">{{ copy.nav.visit[lang] }}</a>
    </nav>
    <span class="lang-switch nav-lang">
      <a href="/" class="{{ 'on' if lang == 'en' }}">EN</a>
      <a href="/ko/" class="{{ 'on' if lang == 'ko' }}">한국어</a>
    </span>
    {% set sz = 15 %}
    <a class="nav-call" href="tel:+6580805181" aria-label="{{ copy.nav.callToBook[lang] }} 8080 5181">{% include "icon-phone.njk" %}{{ copy.nav.callToBook[lang] }}</a>
    <button class="burger" onclick="document.getElementById('mnav').classList.toggle('open')" aria-label="{{ copy.nav.openMenu[lang] }}">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-links" id="mnav">
    <a href="#signature">{{ copy.nav.signature[lang] }}</a>
    <a href="#more-menu">{{ copy.nav.menu[lang] }}</a>
    <a href="#sotbap">{{ copy.nav.sotbap[lang] }}</a>
    <a href="#why">{{ copy.nav.why[lang] }}</a>
    <a href="#news">{{ copy.nav.news[lang] }}</a>
    <a href="#visit">{{ copy.nav.visit[lang] }}</a>
    <a href="{{ site.booking }}" target="_blank" rel="noopener">{{ copy.nav.bookOnline[lang] }}</a>
    <a href="tel:+6580805181">{{ copy.nav.callToBook[lang] }}</a>
    <a href="{{ copy.home[other] }}">{{ copy.common.switchTo[lang] }}</a>
  </div>
</header>

<section class="hero">
  <div class="ember-glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-eyebrow"><span class="dot"></span> {{ copy.hero.eyebrow }}</div>
    <h1>{{ copy.hero.h1[lang] }}<span class="sub-en">{{ copy.hero.h1sub[lang] }}</span></h1>
    <p class="lede">{{ copy.hero.lede[lang] | safe }}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary" href="{{ site.booking }}" target="_blank" rel="noopener">{{ copy.hero.ctaBook[lang] }}</a>
      <a class="btn btn-ghost" href="#signature">{{ copy.hero.ctaMenu[lang] }}</a>
    </div>
    {% set sz = 16 %}
    <div class="hero-info">
      <div class="item">{% include "icon-pin.njk" %}{{ copy.common.address }}</div>
      <div class="item">{% include "icon-clock.njk" %}{{ copy.common.hours[lang] }}</div>
      <div class="item">{% include "icon-phone.njk" %}{{ copy.common.phone }}</div>
    </div>
  </div>
</section>

<section class="section" id="signature">
  <div class="wrap">
    <div class="section-head">
      <div class="label">{{ S.signature.label[lang] }}</div>
      <h2>{{ S.signature.title }}</h2>
      <p>{{ S.signature.intro[lang] | safe }}</p>
    </div>
    {% for d in copy.signature %}
    <div class="dish{% if d.reverse %} reverse{% endif %}">
      <div class="dish-art">
        <img src="{{ d.img }}" loading="lazy" decoding="async" alt="{{ d.alt[lang] }}" style="width:100%; height:100%; object-fit:cover;">
      </div>
      <div class="dish-copy">
        <div class="num">{{ d.num }}</div>
        <h3>{{ d.name[lang] }}{% if d.nameNote %} <span class="en-name" style="display:inline; margin:0;">{{ d.nameNote[lang] }}</span>{% endif %}</h3>
        <span class="en-name">{{ d.sub[lang] | safe }}</span>
        <p>{{ d.desc[lang] }}</p>
        {% for p in d.prices %}<span class="price-tag"{% if not loop.first %} style="margin-left:10px;"{% endif %}>{{ p.label[lang] }} <span class="amt">{{ p.amt }}</span></span>{% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="section dark" id="more-menu">
  <div class="wrap">
    <div class="section-head">
      <div class="label" style="color:var(--brass-400);">{{ S.more.label[lang] }}</div>
      <h2>{{ S.more.title }}</h2>
      <p>{{ S.more.intro[lang] }}</p>
    </div>
    <div class="menu-grid">
      {% for d in copy.more %}
      <div class="menu-cell">
        <div class="cell-photo">
          <img src="{{ d.img }}" alt="{{ d.alt[lang] }}" loading="lazy" decoding="async">
        </div>
        <h4>{{ d.name[lang] }}</h4>
        <span class="en">{{ d.sub[lang] }}</span>
        <p>{{ d.desc[lang] }}</p>
        {% if d.price %}
        <div class="price">{{ d.price }}</div>
        {% else %}
        {% set sz = 13 %}
        <a class="price price-ask" href="tel:+6580805181" aria-label="{{ copy.common.ask[lang] }} 8080 5181">{% include "icon-phone.njk" %}{{ copy.common.ask[lang] }}</a>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="sotbap">
  <div class="wrap">
    <div class="section-head">
      <div class="label">{{ S.sotbap.label[lang] }}</div>
      <h2>{{ S.sotbap.title }}</h2>
      <p>{{ S.sotbap.intro[lang] }}</p>
    </div>
    <div class="sotbap-grid">
      {% for d in copy.sotbap %}
      <div class="sotbap-cell">
        <div class="cell-photo art">
          <img src="{{ d.img }}" alt="{{ d.alt[lang] }}" loading="lazy" decoding="async">
        </div>
        <h4>{{ d.name[lang] }}</h4>
        <span class="en">{{ d.sub[lang] | safe }}</span>
        <p>{{ d.desc[lang] }}</p>
      </div>
      {% endfor %}
    </div>
    <div class="img-note">
      {% include "icon-info.njk" %}
      <span>{{ copy.common.imgNote[lang] }}</span>
    </div>
  </div>
</section>

<section class="section dark" id="space">
  <div class="wrap">
    <div class="section-head">
      <div class="label" style="color:var(--brass-400);">{{ S.space.label[lang] }}</div>
      <h2>{{ S.space.title }}</h2>
      <p>{{ S.space.intro[lang] }}</p>
    </div>
    <div class="space-grid">
      {% for s in copy.space %}
      <div class="space-slot{% if s.wide %} wide{% endif %}">
        <img src="{{ s.img }}" alt="{{ s.alt[lang] }}" loading="lazy" decoding="async">
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section" id="why">
  <div class="wrap">
    <div class="section-head">
      <div class="label">{{ S.why.label[lang] }}</div>
      <h2>{{ S.why.title }}</h2>
    </div>
    <div class="why-grid">
      {% for w in copy.why %}
      <div class="why-item">
        <div class="icon">{% include "icon-" + w.icon + ".njk" %}</div>
        <h3>{{ w.title[lang] }}</h3>
        <p>{{ w.body[lang] }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if news.length %}
<section class="section dark" id="news">
  <div class="wrap">
    <div class="section-head">
      <div class="label" style="color:var(--brass-400);">{{ S.news.label[lang] }}</div>
      <h2>{{ S.news.title }}</h2>
      <p>{{ S.news.intro[lang] }}</p>
    </div>
    <div class="home-news-grid">
      {% for post in news | limit(3) %}
      <a class="home-news-item" href="{{ copy.newsList[lang] }}{{ post.slug }}/">
        <div class="thumb">
          {% if post.cover %}<img src="{{ post.cover }}" alt="{{ post.coverAlt or post[lang].title }}" loading="lazy" decoding="async">{% endif %}
        </div>
        <time datetime="{{ post.date | dateIso }}">{{ post.date | dateFmt(lang) }}</time>
        <h3>{{ post[lang].title }}</h3>
        <p>{{ post[lang].summary }}</p>
      </a>
      {% endfor %}
    </div>
    <a class="news-more" href="{{ copy.newsList[lang] }}">{{ S.news.more[lang] }}</a>
  </div>
</section>
{% endif %}

<section class="section dark" id="visit">
  <div class="wrap">
    <div class="visit">
      <div>
        <div class="section-head" style="margin-bottom:34px;">
          <div class="label" style="color:var(--brass-400);">{{ S.visit.label[lang] }}</div>
          <h2>{{ S.visit.title }}</h2>
        </div>
        {% set sz = 18 %}
        <div class="visit-list">
          <div class="visit-row">
            {% include "icon-pin.njk" %}
            <div>
              <div class="label">{{ S.visit.addressLabel[lang] }}</div>
              <a class="val" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=123+Telok+Ayer+Street+Singapore+068592">{{ copy.common.addressFull }}</a>
            </div>
          </div>
          <div class="visit-row">
            {% include "icon-clock.njk" %}
            <div>
              <div class="label">{{ S.visit.hoursLabel[lang] }}</div>
              <div class="val">{{ copy.common.hours[lang] }}</div>
            </div>
          </div>
          <div class="visit-row">
            {% include "icon-phone.njk" %}
            <div>
              <div class="label">{{ S.visit.phoneLabel[lang] }}</div>
              <a class="val" href="tel:+6580805181">{{ copy.common.phone }}</a>
            </div>
          </div>
          <div class="visit-row">
            {% include "icon-instagram.njk" %}
            <div>
              <div class="label">{{ S.visit.instagramLabel[lang] }}</div>
              <a class="val" target="_blank" rel="noopener" href="{{ site.instagram }}">@cheongdamchae_sg</a>
            </div>
          </div>
        </div>
      </div>
      <div class="map-card">
        <h3>{{ S.visit.bookTitle[lang] }}</h3>
        <p>{{ S.visit.bookBody[lang] }}</p>
        {% set sz = 17 %}
        <div style="display:flex; gap:12px; flex-wrap:wrap;">
          <a class="btn btn-primary" href="{{ site.booking }}" target="_blank" rel="noopener" style="width:fit-content;">{{ copy.nav.bookOnline[lang] }}</a>
          <a class="btn btn-ghost" href="tel:+6580805181" style="width:fit-content;">{% include "icon-phone.njk" %}{{ S.visit.callBtn[lang] }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div style="display:flex; align-items:center; gap:14px; margin-bottom:28px;">
      <img src="/images/logo.png" width="381" height="191" loading="lazy" decoding="async" alt="CheongDamChae 청담채 logo" style="height:32px; width:auto; opacity:0.9;">
    </div>
    <div class="foot-row" style="align-items:flex-start; margin-bottom:28px;">
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div>{{ copy.common.addressFull }}</div>
        <div>{{ copy.common.hours[lang] }}</div>
        <a href="tel:+6580805181">{{ copy.common.phone }}</a>
      </div>
      <div style="display:flex; gap:24px; flex-wrap:wrap;">
        <a target="_blank" rel="noopener" href="{{ site.booking }}">{{ copy.hero.ctaBook[lang] }}</a>
        <a target="_blank" rel="noopener" href="{{ site.instagram }}">Instagram</a>
        <a href="{{ copy.newsList[lang] }}">{{ copy.nav.news[lang] }}</a>
        <a href="{{ copy.home[other] }}">{{ copy.common.switchShort[lang] }}</a>
      </div>
    </div>
    <div style="font-size:0.8rem; opacity:0.6; border-top:1px solid rgba(176,138,78,0.2); padding-top:18px;">
      {{ copy.common.imgNote[lang] }}<br>
      © 2026 CheongDamChae 청담채
    </div>
  </div>
</footer>

</body>
</html>
